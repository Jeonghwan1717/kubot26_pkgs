  <transmission name="trans_R_Ankle_roll_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="R_Ankle_roll_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="motor_R_Ankle_roll_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans_L_Shoulder_roll_joint">
