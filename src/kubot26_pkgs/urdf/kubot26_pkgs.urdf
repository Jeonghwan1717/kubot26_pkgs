    <joint name="L_Shoulder_roll_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="motor_L_Shoulder_roll_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans_L_Elbow_pitch_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="L_Elbow_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="motor_L_Elbow_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans_L_Hand_pitch_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="L_Hand_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="motor_L_Hand_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans_R_Shoulder_roll_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="R_Shoulder_roll_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="motor_R_Shoulder_roll_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans_R_Elbow_pitch_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="R_Elbow_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="motor_R_Elbow_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans_R_Hand_pitch_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="R_Hand_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
    <actuator name="motor_R_Hand_pitch_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface><mechanicalReduction>1</mechanicalReduction></actuator>
  </transmission>
  <transmission name="trans_Neck_yaw_joint">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="Neck_yaw_joint"><hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface></joint>
