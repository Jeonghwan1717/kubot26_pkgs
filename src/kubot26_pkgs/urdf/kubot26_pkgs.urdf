  <!-- ===== [옵션] 고정 베이스 테스트용 world 핀 =====
       kubot25_ws 의 urdf 에는 아래 블록이 활성화되어 있어 base_link 가 공중에 고정됩니다.
       보행/낙하 시뮬레이션을 하려면 비활성(주석) 상태로 두고,
       IK/관절 단독 검증만 할 때 주석을 풀어 사용하십시오.
  <link name="world"/>
  <joint name="fixed_to_world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="fixed_to_world">
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  ============================================== -->

